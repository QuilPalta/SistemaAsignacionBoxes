package com.hospital.presentation;

import com.hospital.business.BoxService;
import com.hospital.entities.Box;

import javax.jws.WebMethod;
import javax.jws.WebParam;
import javax.jws.WebService;
import javax.jws.soap.SOAPBinding;
import javax.jws.soap.SOAPBinding.Style;
import java.sql.Timestamp;
import java.util.List;

@WebService
@SOAPBinding(style = Style.DOCUMENT)
public class BoxWebService {
    
    private BoxService boxService;
    
    public BoxWebService() {
        this.boxService = new BoxService();
    }
    
    @WebMethod
    public String asignarMedicoABox(
            @WebParam(name = "boxId") int boxId,
            @WebParam(name = "medicoRut") String medicoRut,
            @WebParam(name = "horaInicio") Timestamp horaInicio,
            @WebParam(name = "horaFin") Timestamp horaFin) {
        try {
            return boxService.asignarMedicoABox(boxId, medicoRut, horaInicio, horaFin);
        } catch (Exception e) {
            throw new RuntimeException(e.getMessage());
        }
    }
    
    @WebMethod
    public List<Box> filtrarBoxesPorEstado(
            @WebParam(name = "estado") int estado) {
        try {
            return boxService.filtrarBoxesPorEstado(estado);
        } catch (Exception e) {
            throw new RuntimeException(e.getMessage());
        }
    }
    
    @WebMethod
    public String liberarBox(
            @WebParam(name = "boxId") int boxId,
            @WebParam(name = "asignacionId") int asignacionId) {
        try {
            return boxService.liberarBox(boxId, asignacionId);
        } catch (Exception e) {
            throw new RuntimeException(e.getMessage());
        }
    }
}
